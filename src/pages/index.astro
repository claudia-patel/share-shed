---
import Layout from '../layouts/Layout.astro'

const categories = [
  { icon: "🧸", name: "Kids & Toys", count: 24 },
  { icon: "👶", name: "Baby Gear", count: 18 },
  { icon: "🏕️", name: "Camping & Outdoors", count: 12 },
  { icon: "🏠", name: "Household", count: 31 },
  { icon: "🔧", name: "Tools & DIY", count: 9 },
  { icon: "📚", name: "Books & Media", count: 22 },
  { icon: "👗", name: "Clothing", count: 15 },
  { icon: "🌱", name: "Garden & Patio", count: 8 },
]

const sampleItems = [
  {
    title: "Graco Pack 'n Play",
    category: "Baby Gear",
    condition: "Great",
    desc: "Barely used. Our little one outgrew it. Comes with the bassinet attachment and changing pad.",
    neighborhood: "Chesterfield Valley",
    distance: "0.3 mi",
    posted: "2 hours ago",
    type: "Free",
    img: "👶"
  },
  {
    title: "Kids' Bike (16 inch)",
    category: "Kids & Toys",
    condition: "Good",
    desc: "Blue Schwinn, training wheels included. Some scratches but rides perfectly. Great starter bike.",
    neighborhood: "Wildwood",
    distance: "0.7 mi",
    posted: "5 hours ago",
    type: "Free",
    img: "🚲"
  },
  {
    title: "4-Person Camping Tent",
    category: "Camping & Outdoors",
    condition: "Like New",
    desc: "Used twice. REI Half Dome. All poles, stakes, and rain fly included. Just don't camp enough to justify keeping it.",
    neighborhood: "Ballwin",
    distance: "0.5 mi",
    posted: "1 day ago",
    type: "Borrow",
    img: "⛺"
  },
  {
    title: "KitchenAid Stand Mixer",
    category: "Household",
    condition: "Good",
    desc: "Classic red, works great. Got a new one as a gift so passing this along. Comes with 3 attachments.",
    neighborhood: "Chesterfield",
    distance: "0.2 mi",
    posted: "1 day ago",
    type: "Free",
    img: "🍳"
  },
  {
    title: "Box of Duplo Blocks (200+ pieces)",
    category: "Kids & Toys",
    condition: "Great",
    desc: "Huge collection of Duplo blocks, vehicles, and figures. Our kids moved on to regular Legos. Hours of fun for toddlers.",
    neighborhood: "Ellisville",
    distance: "0.9 mi",
    posted: "2 days ago",
    type: "Free",
    img: "🧱"
  },
  {
    title: "Jogger Stroller (BOB)",
    category: "Baby Gear",
    condition: "Good",
    desc: "BOB Revolution. Tires hold air, canopy is clean, folds easily. We're past the stroller phase!",
    neighborhood: "Chesterfield Valley",
    distance: "0.4 mi",
    posted: "3 days ago",
    type: "Free",
    img: "🏃"
  },
]

const stats = [
  { num: "1,247", label: "Items Shared" },
  { num: "892", label: "Neighbors Connected" },
  { num: "3.2 tons", label: "Kept Out of Landfills" },
]
---

<Layout title="ShareShed — Neighborhood Sharing Network">

  <!-- Location Gate -->
  <div id="location-gate" class="location-gate">
    <div class="location-card">
      <span class="loc-icon">📍</span>
      <h2>Find Your Neighbors</h2>
      <p>ShareShed connects you with people within 1 mile of your home. We use your location to show only nearby items and keep sharing local.</p>
      <button id="enable-location" class="btn-primary">Enable Location</button>
      <p class="loc-fine-print">Your exact address is never shared. We only show your neighborhood name to other members.</p>
    </div>
  </div>

  <!-- Location Bar -->
  <div id="location-bar" class="location-bar" style="display:none;">
    <div class="section-container loc-bar-inner">
      <span class="loc-bar-text">📍 Showing items within <strong>1 mile</strong> of you</span>
      <span id="loc-bar-hood" class="loc-bar-hood"></span>
    </div>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <span class="hero-badge">🌿 Zero waste. Zero cost. Zero strangers.</span>
      <h1>Your neighborhood's<br>sharing network</h1>
      <p>Give what you don't need. Find what you do. No money changes hands. Just neighbors helping neighbors reduce waste and build community.</p>
      <div class="hero-actions">
        <a href="#browse" class="btn-primary">Browse Items</a>
        <a href="#post" class="btn-secondary">Share Something</a>
      </div>
    </div>
    <div class="hero-stats">
      {stats.map(s => (
        <div class="stat">
          <span class="stat-num">{s.num}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Categories -->
  <section class="categories" id="browse">
    <div class="section-container">
      <h2>Browse by Category</h2>
      <div class="cat-grid">
        {categories.map(c => (
          <button class="cat-card" data-category={c.name}>
            <span class="cat-icon">{c.icon}</span>
            <span class="cat-name">{c.name}</span>
            <span class="cat-count">{c.count} items</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Items -->
  <section class="items">
    <div class="section-container">
      <div class="items-header">
        <h2>Recently Shared</h2>
        <div class="filter-row">
          <select id="filter-type" class="filter-select">
            <option value="all">All Types</option>
            <option value="Free">Free to Take</option>
            <option value="Borrow">Available to Borrow</option>
          </select>
          <select id="filter-condition" class="filter-select">
            <option value="all">Any Condition</option>
            <option value="Like New">Like New</option>
            <option value="Great">Great</option>
            <option value="Good">Good</option>
          </select>
        </div>
      </div>
      <div class="items-grid" id="items-grid">
        {sampleItems.map(item => (
          <div class="item-card" data-type={item.type} data-condition={item.condition} data-category={item.category}>
            <div class="item-visual">
              <span class="item-emoji">{item.img}</span>
              <span class={`item-badge ${item.type === 'Free' ? 'badge-free' : 'badge-borrow'}`}>{item.type}</span>
            </div>
            <div class="item-body">
              <h3>{item.title}</h3>
              <p class="item-desc">{item.desc}</p>
              <div class="item-meta">
                <span class="meta-tag">📍 {item.distance} &middot; {item.neighborhood}</span>
                <span class="meta-tag">✨ {item.condition}</span>
              </div>
              <div class="item-footer">
                <span class="item-time">🤝 Pledged &middot; {item.posted}</span>
                <button class="btn-interest">I'm Interested</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how" id="how">
    <div class="section-container">
      <h2>How It Works</h2>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Post or Browse</h3>
          <p>Got something collecting dust? Post it. Need something? Browse what your neighbors are sharing.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Connect</h3>
          <p>Found something you need? Tap "I'm Interested" and connect directly with your neighbor. No middleman.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Share & Reduce</h3>
          <p>Pick up locally. No shipping, no packaging, no waste. Just one less thing heading to the landfill.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Karma Points -->
  <section class="karma-section" id="karma">
    <div class="section-container">
      <div class="karma-header">
        <h2>🌟 Neighbor Karma</h2>
        <p class="karma-intro">Give more, earn more. Our points system rewards generosity and responsibility. No money involved, just community cred.</p>
      </div>

      <div class="karma-ways-grid">
        <div class="karma-way earn">
          <h3>Earn Points</h3>
          <ul>
            <li><span class="karma-pts">+25</span> Share an item (free to take)</li>
            <li><span class="karma-pts">+15</span> Lend an item (borrow)</li>
            <li><span class="karma-pts">+10</span> Return a borrowed item on time</li>
            <li><span class="karma-pts">+15</span> Return in great condition</li>
            <li><span class="karma-pts">+5</span> Leave a thank-you note</li>
            <li><span class="karma-pts">+50</span> Share 10+ items (milestone bonus)</li>
          </ul>
        </div>
        <div class="karma-way levels">
          <h3>Karma Levels</h3>
          <div class="karma-level">
            <span class="karma-badge badge-seed">🌱</span>
            <div>
              <strong>Seed</strong>
              <span class="karma-range">0 - 49 pts</span>
              <p>Just getting started. Welcome to the shed!</p>
            </div>
          </div>
          <div class="karma-level">
            <span class="karma-badge badge-sprout">🌿</span>
            <div>
              <strong>Sprout</strong>
              <span class="karma-range">50 - 149 pts</span>
              <p>You're making a difference.</p>
            </div>
          </div>
          <div class="karma-level">
            <span class="karma-badge badge-tree">🌳</span>
            <div>
              <strong>Tree</strong>
              <span class="karma-range">150 - 499 pts</span>
              <p>Neighborhood MVP. People know your name.</p>
            </div>
          </div>
          <div class="karma-level">
            <span class="karma-badge badge-forest">🌲</span>
            <div>
              <strong>Old Growth</strong>
              <span class="karma-range">500+ pts</span>
              <p>Legend. You're basically the neighborhood.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="karma-leaderboard">
        <h3>Top Neighbors This Month</h3>
        <div class="leaderboard-list">
          <div class="lb-row">
            <span class="lb-rank">1</span>
            <span class="lb-badge">🌳</span>
            <span class="lb-name">Sarah M.</span>
            <span class="lb-hood">Chesterfield</span>
            <span class="lb-pts">285 pts</span>
          </div>
          <div class="lb-row">
            <span class="lb-rank">2</span>
            <span class="lb-badge">🌳</span>
            <span class="lb-name">David R.</span>
            <span class="lb-hood">Wildwood</span>
            <span class="lb-pts">210 pts</span>
          </div>
          <div class="lb-row">
            <span class="lb-rank">3</span>
            <span class="lb-badge">🌿</span>
            <span class="lb-name">Priya K.</span>
            <span class="lb-hood">Ballwin</span>
            <span class="lb-pts">145 pts</span>
          </div>
          <div class="lb-row">
            <span class="lb-rank">4</span>
            <span class="lb-badge">🌿</span>
            <span class="lb-name">Mike T.</span>
            <span class="lb-hood">Ellisville</span>
            <span class="lb-pts">120 pts</span>
          </div>
          <div class="lb-row">
            <span class="lb-rank">5</span>
            <span class="lb-badge">🌿</span>
            <span class="lb-name">Jessica L.</span>
            <span class="lb-hood">Chesterfield Valley</span>
            <span class="lb-pts">95 pts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pledge -->
  <section class="pledge-section">
    <div class="section-container">
      <div class="pledge-card">
        <div class="pledge-icon">🤝</div>
        <h2>The ShareShed Pledge</h2>
        <p class="pledge-text">ShareShed is built on trust. Every member agrees to one simple rule:</p>
        <blockquote class="pledge-quote">
          "I pledge to share freely and never resell items received through ShareShed. These items are given in good faith to reduce waste and help my neighbors, not for profit."
        </blockquote>
        <div class="pledge-stats-row">
          <div class="pledge-stat">
            <span class="pledge-stat-num">100%</span>
            <span class="pledge-stat-label">Honor-based</span>
          </div>
          <div class="pledge-stat">
            <span class="pledge-stat-num">$0</span>
            <span class="pledge-stat-label">Always free</span>
          </div>
          <div class="pledge-stat">
            <span class="pledge-stat-num">0</span>
            <span class="pledge-stat-label">Tolerance for reselling</span>
          </div>
        </div>
        <p class="pledge-footer-text">If you no longer need an item you received, pass it forward to another neighbor. That's the deal.</p>
      </div>
    </div>
  </section>

  <!-- Post form -->
  <section class="post-section" id="post">
    <div class="section-container">
      <div class="post-card">
        <h2>Share an Item</h2>
        <p class="post-intro">One person's outgrown toy is another kid's new favorite. Share what you have.</p>
        <form id="post-form" class="post-form">
          <div class="form-row">
            <div class="form-group">
              <label for="item-title">What are you sharing?</label>
              <input type="text" id="item-title" placeholder="e.g., Kids' scooter, barely used" required />
            </div>
            <div class="form-group">
              <label for="item-category">Category</label>
              <select id="item-category" required>
                <option value="">Select...</option>
                <option>Kids & Toys</option>
                <option>Baby Gear</option>
                <option>Camping & Outdoors</option>
                <option>Household</option>
                <option>Tools & DIY</option>
                <option>Books & Media</option>
                <option>Clothing</option>
                <option>Garden & Patio</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="item-condition-input">Condition</label>
              <select id="item-condition-input" required>
                <option value="">Select...</option>
                <option>Like New</option>
                <option>Great</option>
                <option>Good</option>
                <option>Fair</option>
              </select>
            </div>
            <div class="form-group">
              <label for="item-type-input">Type</label>
              <select id="item-type-input" required>
                <option value="Free">Free to Take</option>
                <option value="Borrow">Available to Borrow</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="item-desc-input">Description</label>
            <textarea id="item-desc-input" rows="3" placeholder="Tell your neighbors about this item. What's included? Why are you sharing it?"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="item-neighborhood">Your Neighborhood</label>
              <input type="text" id="item-neighborhood" placeholder="e.g., Chesterfield" required />
            </div>
            <div class="form-group">
              <label for="item-contact">Your Email</label>
              <input type="email" id="item-contact" placeholder="your@email.com" required />
            </div>
          </div>
          <label class="pledge-check">
            <input type="checkbox" id="pledge-agree" required />
            <span>I agree to the <strong>ShareShed Pledge</strong>: I will not resell items I receive. If I no longer need something, I'll pass it forward to another neighbor.</span>
          </label>
          <button type="submit" class="btn-primary btn-full">Post Item</button>
        </form>
        <div id="post-success" class="post-success" style="display:none;">
          <span class="success-icon">🎉</span>
          <h3>Item Posted!</h3>
          <p>Your neighbors can now see your listing. Thanks for sharing instead of tossing!</p>
          <button onclick="document.getElementById('post-success').style.display='none'; document.getElementById('post-form').style.display='grid'; document.getElementById('post-form').reset();" class="btn-secondary">Post Another</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="mission">
    <div class="section-container mission-inner">
      <h2>Why ShareShed?</h2>
      <div class="mission-grid">
        <div class="mission-card">
          <span class="mission-icon">🌍</span>
          <h3>Reduce Waste</h3>
          <p>Americans throw away 292.4 million tons of stuff each year. Most of it isn't trash. It's just in the wrong house.</p>
        </div>
        <div class="mission-card">
          <span class="mission-icon">🤝</span>
          <h3>Build Community</h3>
          <p>Everyone wants a village. This is how you build one. One borrowed tent, one handed-down bike at a time.</p>
        </div>
        <div class="mission-card">
          <span class="mission-icon">💚</span>
          <h3>Save Money</h3>
          <p>Stop buying things you'll use twice. Your neighbor probably has one sitting in their garage right now.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Location gate
  const gate = document.getElementById('location-gate')!
  const bar = document.getElementById('location-bar')!
  const barHood = document.getElementById('loc-bar-hood')!

  // Check if already granted
  if (localStorage.getItem('shareshed-location')) {
    gate.style.display = 'none'
    bar.style.display = 'block'
    barHood.textContent = localStorage.getItem('shareshed-hood') || ''
  }

  document.getElementById('enable-location')?.addEventListener('click', () => {
    const btn = document.getElementById('enable-location') as HTMLButtonElement
    btn.textContent = 'Finding you...'
    btn.disabled = true

    if ('geolocation' in navigator) {
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const { latitude, longitude } = pos.coords
          localStorage.setItem('shareshed-location', JSON.stringify({ lat: latitude, lng: longitude }))

          // Reverse geocode for neighborhood name
          try {
            const resp = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${latitude}&lon=${longitude}&format=json`)
            const data = await resp.json()
            const hood = data.address?.suburb || data.address?.neighbourhood || data.address?.city || 'Your Area'
            localStorage.setItem('shareshed-hood', hood)
            barHood.textContent = hood
          } catch {
            barHood.textContent = 'Your Neighborhood'
          }

          gate.style.display = 'none'
          bar.style.display = 'block'
        },
        () => {
          btn.textContent = 'Enable Location'
          btn.disabled = false
          alert('Location access is needed to find neighbors near you. Please allow location access and try again.')
        },
        { enableHighAccuracy: true }
      )
    } else {
      alert('Your browser doesn\'t support location services.')
      btn.textContent = 'Enable Location'
      btn.disabled = false
    }
  })

  // Filters
  document.getElementById('filter-type')?.addEventListener('change', filterItems)
  document.getElementById('filter-condition')?.addEventListener('change', filterItems)

  function filterItems() {
    const type = (document.getElementById('filter-type') as HTMLSelectElement).value
    const condition = (document.getElementById('filter-condition') as HTMLSelectElement).value
    document.querySelectorAll('.item-card').forEach(card => {
      const el = card as HTMLElement
      const matchType = type === 'all' || el.dataset.type === type
      const matchCondition = condition === 'all' || el.dataset.condition === condition
      el.style.display = matchType && matchCondition ? '' : 'none'
    })
  }

  // Category filter
  document.querySelectorAll('.cat-card').forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.category
      document.querySelectorAll('.item-card').forEach(card => {
        const el = card as HTMLElement
        el.style.display = !cat || el.dataset.category === cat ? '' : 'none'
      })
      // Scroll to items
      document.querySelector('.items')?.scrollIntoView({ behavior: 'smooth' })
    })
  })

  // Post form
  document.getElementById('post-form')?.addEventListener('submit', (e) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    form.style.display = 'none'
    document.getElementById('post-success')!.style.display = 'flex'
  })

  // Interest buttons
  document.querySelectorAll('.btn-interest').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLButtonElement
      b.textContent = '✓ Request Sent!'
      b.classList.add('btn-interested')
      b.disabled = true
    })
  })
</script>

<style>
  /* Location */
  .location-gate {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 1.5rem;
  }
  .location-card {
    background: var(--surface);
    border-radius: 16px;
    padding: 3rem 2.5rem;
    max-width: 440px;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
  }
  .loc-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
  .location-card h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
  }
  .location-card > p {
    color: var(--text-mid);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  .location-card .btn-primary { width: 100%; padding: 1rem; font-size: 1rem; margin-bottom: 1rem; }
  .loc-fine-print {
    font-size: 0.78rem !important;
    color: var(--text-light) !important;
    margin-bottom: 0 !important;
  }
  .location-bar {
    background: var(--green-bg);
    border-bottom: 1px solid var(--green-soft);
    padding: 0.6rem 0;
  }
  .loc-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--green);
  }
  .loc-bar-hood { font-weight: 600; }

  /* Hero */
  .hero {
    padding: 5rem 1.5rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-content { max-width: 650px; }
  .hero-badge {
    display: inline-block;
    background: var(--green-bg);
    color: var(--green);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 3.5rem;
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }
  .hero > .hero-content > p {
    font-size: 1.15rem;
    color: var(--text-mid);
    max-width: 520px;
    margin-bottom: 2rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    display: inline-block;
    background: var(--green);
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--green-light); }
  .btn-secondary {
    display: inline-block;
    background: var(--surface);
    color: var(--green);
    border: 1.5px solid var(--green);
    padding: 0.8rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-secondary:hover { background: var(--green-bg); }
  .hero-stats {
    display: flex;
    gap: 3rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .stat-num {
    display: block;
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    color: var(--green);
  }
  .stat-label {
    font-size: 0.85rem;
    color: var(--text-light);
